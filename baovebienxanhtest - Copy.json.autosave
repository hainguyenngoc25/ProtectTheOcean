Back","persistentUuid":"06d1562b-ff66-4e70-84d4-807d57cc3526","width":0.0,"x":6.0,"y":603.0,"zOrder":4,"numberProperties":[],"stringProperties":[],"initialVariables":[]}],"objects":[{"assetStoreId":"","bold":false,"italic":false,"name":"Tutorial","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[],"string":"Bấm SPACE để thả lưỡi câu\nMỗi 1 loại rác thải sẽ có khối lượng khác nhau, cần tính toán kĩ trước khi câu\nVới các màn di chuyển bằng thuyền, sử dụng các phím điều hướng để điều khiển thuyền di chuyển\nCẩn thận khi câu phải cá khiến bạn có thể bị trừ mạng\nThua khi không câu đủ số lượng rác hoặc mất hết mạng.\n....\n\nMulti Player sẽ được update khi làm xong cái đầu","font":"","textAlignment":"left","characterSize":40.0,"color":{"b":0,"g":0,"r":0},"content":{"bold":false,"isOutlineEnabled":false,"isShadowEnabled":false,"italic":false,"outlineColor":"255;255;255","outlineThickness":2.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"Bấm SPACE để thả lưỡi câu\nMỗi 1 loại rác thải sẽ có khối lượng khác nhau, cần tính toán kĩ trước khi câu\nVới các màn di chuyển bằng thuyền, sử dụng các phím điều hướng để điều khiển thuyền di chuyển\nCẩn thận khi câu phải cá khiến bạn có thể bị trừ mạng\nThua khi không câu đủ số lượng rác hoặc mất hết mạng.\n....\n\nMulti Player sẽ được update khi làm xong cái đầu","font":"","textAlignment":"left","verticalTextAlignment":"top","characterSize":40.0,"lineHeight":0.0,"color":"0;0;0"}},{"adaptCollisionMaskAutomatically":true,"assetStoreId":"","name":"NewSprite","type":"Sprite","updateIfNotVisible":false,"variables":[],"effects":[],"behaviors":[],"animations":[{"name":"","useMultipleDirections":false,"directions":[{"looping":false,"timeBetweenFrames":0.08,"sprites":[{"hasCustomCollisionMask":true,"image":"pixel-art-underwater-scene-with-fish-coral-and-rocks-vector.jpg","points":[],"originPoint":{"name":"origine","x":0.0,"y":0.0},"centerPoint":{"automatic":true,"name":"centre","x":0.0,"y":0.0},"customCollisionMask":[[{"x":0.0,"y":0.0},{"x":1755.0,"y":0.0},{"x":1755.0,"y":980.0},{"x":0.0,"y":980.0}]]}]}]}]},{"assetStoreId":"","name":"Title","type":"BitmapText::BitmapTextObject","variables":[],"effects":[],"behaviors":[],"content":{"text":"HOW TO PLAY ?","opacity":255.0,"scale":4.0,"fontSize":20.0,"tint":"255;255;255","bitmapFontResourceName":"8BitOperatorPlus8Regular_Edited2.fnt","textureAtlasResourceName":"8BitOperatorPlus8Regular_Edited4.png","align":"left","verticalTextAlignment":"top"}},{"assetStoreId":"","bold":true,"italic":false,"name":"t1","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[{"name":"AutoTyping","type":"AutoTyping::AutoTyping","Text":"Text","Interval":0.05,"CharacterJustAdded":false,"FullText":"","TypedText":""}],"string":"Đại dương từng là nơi khởi nguồn của sự sống xanh thẳm và tràn đầy sinh khí.\nNhưng theo thời gian, rác thải của con người đã phủ kín mặt biển, đẩy các sinh vật vào nguy hiểm.\nMỗi ngày trôi qua, đại dương lại yếu đi một chút.\nHãy bắt đầu hành trình làm sạch biển và bảo vệ sự sống dưới lòng đại dương.\nMỗi nhiệm vụ hoàn thành là một bước đưa đại dương trở lại màu xanh vốn có.","font":"kvn-94.ttf","textAlignment":"left","characterSize":30.0,"color":{"b":255,"g":255,"r":255},"content":{"bold":true,"isOutlineEnabled":true,"isShadowEnabled":false,"italic":false,"outlineColor":"0;0;0","outlineThickness":10.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"Đại dương từng là nơi khởi nguồn của sự sống xanh thẳm và tràn đầy sinh khí.\nNhưng theo thời gian, rác thải của con người đã phủ kín mặt biển, đẩy các sinh vật vào nguy hiểm.\nMỗi ngày trôi qua, đại dương lại yếu đi một chút.\nHãy bắt đầu hành trình làm sạch biển và bảo vệ sự sống dưới lòng đại dương.\nMỗi nhiệm vụ hoàn thành là một bước đưa đại dương trở lại màu xanh vốn có.","font":"kvn-94.ttf","textAlignment":"left","verticalTextAlignment":"top","characterSize":30.0,"lineHeight":0.0,"color":"255;255;255"}},{"assetStoreId":"","bold":true,"italic":false,"name":"t2","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[{"name":"AutoTyping","type":"AutoTyping::AutoTyping","Text":"Text","Interval":0.05,"CharacterJustAdded":false,"FullText":"","TypedText":""}],"string":"Protect the Ocean – Hành động nhỏ, thay đổi lớn.","font":"kvn-94.ttf","textAlignment":"left","characterSize":25.0,"color":{"b":255,"g":255,"r":255},"content":{"bold":true,"isOutlineEnabled":true,"isShadowEnabled":false,"italic":false,"outlineColor":"0;0;0","outlineThickness":10.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"Protect the Ocean – Hành động nhỏ, thay đổi lớn.","font":"kvn-94.ttf","textAlignment":"left","verticalTextAlignment":"top","characterSize":25.0,"lineHeight":0.0,"color":"255;255;255"}},{"assetStoreId":"","bold":true,"italic":false,"name":"t3","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[],"string":"Với các màn di chuyển bằng thuyền, sử dụng các phím điều hướng để điều khiển thuyền di chuyển","font":"kvn-94.ttf","textAlignment":"left","characterSize":35.0,"color":{"b":255,"g":255,"r":255},"content":{"bold":true,"isOutlineEnabled":true,"isShadowEnabled":false,"italic":false,"outlineColor":"0;0;0","outlineThickness":10.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"Với các màn di chuyển bằng thuyền, sử dụng các phím điều hướng để điều khiển thuyền di chuyển","font":"kvn-94.ttf","textAlignment":"left","verticalTextAlignment":"top","characterSize":35.0,"lineHeight":0.0,"color":"255;255